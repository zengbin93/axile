# 说明：主服务端（axile server）的配置只来自 config.toml（见 example.config.toml），
# 刻意不读取 .env / 进程环境变量。本文件供 tests/live 使用。

# 上游量化数据 token，由联机测试通过 os.getenv 读取。
CZSC_TOKEN="your czsc token"
CZSC_DATA_API="http://127.0.0.1:18000"

# 客户端向受保护的 API 发送鉴权用（x-api-password 头或 Basic Auth）；
# 本地默认 server 已移除运行时鉴权，可留空。
AXILE_API_PASSWORD=""
